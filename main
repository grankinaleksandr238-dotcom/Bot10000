@dp.message_handler(state=DiceBet.amount)
async def dice_bet_amount(message: types.Message, state: FSMContext):
    if message.text == "◀️ Назад":
        await state.finish()
        await casino_menu(message)
        return
    try:
        amount = int(message.text)
        if amount <= 0:
            raise ValueError
    except ValueError:
        await message.answer("❌ Введи положительное целое число.")
        return
    user_id = message.from_user.id
    balance = await get_user_balance(user_id)
    if balance < amount:
        await message.answer("❌ Недостаточно баксов.")
        await state.finish()
        return
    min_bet = int(await get_setting("casino_min_bet"))
    max_bet = int(await get_setting("casino_max_bet"))
    if amount < min_bet or amount > max_bet:
        await message.answer(f"❌ Ставка должна быть от {min_bet} до {max_bet} баксов.")
        await state.finish()
        return
    await state.update_data(amount=amount)
    await message.answer("Бросаем кости...")
    await asyncio.sleep(1)
    dice1 = random.randint(1, 6)
    dice2 = random.randint(1, 6)
    total = dice1 + dice2
    multiplier = int(await get_setting("dice_multiplier"))
    if total > 7:
        win = amount * multiplier
        await update_user_balance(user_id, win)
        await update_user_game_stats(user_id, 'dice', win=True)
        exp = int(await get_setting("exp_per_dice_win"))
        await add_exp(user_id, exp)
        await update_user_global_authority(user_id, 1)
        phrase = get_random_phrase(DICE_WIN_PHRASES, dice1=dice1, dice2=dice2, total=total, profit=win)
        await message.answer(phrase, reply_markup=user_main_keyboard(await is_admin(user_id)))
    else:
        loss = amount
        await update_user_balance(user_id, -loss)
        await update_user_game_stats(user_id, 'dice', win=False)
        exp = int(await get_setting("exp_per_dice_lose"))
        await add_exp(user_id, exp)
        phrase = get_random_phrase(DICE_LOSE_PHRASES, dice1=dice1, dice2=dice2, total=total, loss=loss)
        await message.answer(phrase, reply_markup=user_main_keyboard(await is_admin(user_id)))
    await state.finish()

