    kb = types.InlineKeyboardMarkup(row_width=2)
    kb.add(
        types.InlineKeyboardButton("🔴 Красное", callback_data="roulette_red"),
        types.InlineKeyboardButton("⚫️ Чёрное", callback_data="roulette_black"),
        types.InlineKeyboardButton("🟢 Зеро", callback_data="roulette_green"),
        types.InlineKeyboardButton("🔢 Число", callback_data="roulette_number"),
        types.InlineKeyboardButton("◀️ Отмена", callback_data="roulette_cancel")
    )
    await message.answer("Выбери тип ставки:", reply_markup=kb)
    await RouletteBet.bet_type.set()

@dp.callback_query_handler(lambda c: c.data.startswith("roulette_"), state=RouletteBet.bet_type)
async def roulette_bet_type(callback: types.CallbackQuery, state: FSMContext):
    action = callback.data.split("_")[1]
    if action == "cancel":
        await callback.message.delete()
        await state.finish()
        await casino_menu(callback.message)
        await callback.answer()
        return
    if action in ("red", "black", "green"):
        await state.update_data(bet_type=action, number=None)
        await callback.message.delete()
        await process_roulette_spin(callback.message, state)
        await callback.answer()
    elif action == "number":
        await state.update_data(bet_type="number")
        await callback.message.edit_text("Введи число от 0 до 36:")
        await RouletteBet.number.set()
        await callback.answer()

@dp.message_handler(state=RouletteBet.number)
async def roulette_bet_number(message: types.Message, state: FSMContext):
    if message.text == "◀️ Назад":
        await state.finish()
        await casino_menu(message)
        return
    try:
        number = int(message.text)
        if number < 0 or number > 36:
            raise ValueError
    except ValueError:
        await message.answer("❌ Введи целое число от 0 до 36.")
        return
    await state.update_data(number=number)
    await process_roulette_spin(message, state)

async def process_roulette_spin(message: types.Message, state: FSMContext):
    data = await state.get_data()
    amount = data['amount']
    bet_type = data['bet_type']
    bet_number = data.get('number')
    user_id = message.from_user.id
    
    spin_number, color, win = roulette_spin(bet_type, bet_number)
    multiplier = 36 if bet_type == "number" else (18 if bet_type == "green" else 2)
    if win:
        profit = amount * multiplier
        await update_user_balance(user_id, profit)
        await update_user_game_stats(user_id, 'roulette', win=True)
        exp = int(await get_setting("exp_per_roulette_win"))
        await add_exp(user_id, exp)
        await update_user_global_authority(user_id, 2)
        phrase = get_random_phrase(ROULETTE_WIN_PHRASES, number=spin_number, color=color, profit=profit)
    else:
        loss = amount
        await update_user_balance(user_id, -loss)
        await update_user_game_stats(user_id, 'roulette', win=False)
        exp = int(await get_setting("exp_per_roulette_lose"))
        await add_exp(user_id, exp)
        phrase = get_random_phrase(ROULETTE_LOSE_PHRASES, number=spin_number, color=color, loss=loss)
    await message.answer(phrase, reply_markup=user_main_keyboard(await is_admin(user_id)))
    await state.finish()

