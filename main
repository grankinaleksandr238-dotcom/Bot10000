        return
    data = await state.get_data()
    amount = data['amount']
    user_id = message.from_user.id
    async with db_pool.acquire() as conn:
        # Создаём оффер
        offer_id = await conn.fetchval(
            "INSERT INTO authority_offers (seller_id, amount, price_per_unit) VALUES ($1, $2, $3) RETURNING id",
            user_id, amount, price
        )
    await message.answer(f"✅ Предложение на продажу {amount} авторитета по цене {price} баксов/ед создано! ID: {offer_id}")
    await state.finish()
    await authority_shop_menu(message)

@dp.message_handler(lambda message: message.text == "🛒 Купить авторитет")
async def buy_authority_list(message: types.Message):
    if message.chat.type != 'private':
        return
    user_id = message.from_user.id
    if await is_banned(user_id):
        return
    ok, not_subscribed = await check_subscription(user_id)
    if not ok:
        await message.answer("❗️ Сначала подпишись на каналы.", reply_markup=subscription_inline(not_subscribed))
        return
    async with db_pool.acquire() as conn:
        offers = await conn.fetch(
            "SELECT id, seller_id, amount, price_per_unit, created_at FROM authority_offers WHERE status='active' ORDER BY created_at"
        )
    if not offers:
        await message.answer("📭 Нет активных предложений на продажу.")
        return
    text = "📋 Активные предложения:\n\n"
    kb = InlineKeyboardMarkup(row_width=1)
    for offer in offers:
        seller_name = (await conn.fetchval("SELECT first_name FROM users WHERE user_id=$1", offer['seller_id'])) or f"ID {offer['seller_id']}"
        text += f"🆔 {offer['id']} | Продавец: {seller_name}\n   Количество: {offer['amount']}, Цена за ед: {offer['price_per_unit']} баксов\n   Общая стоимость: {offer['amount'] * offer['price_per_unit']} баксов\n\n"
        kb.add(InlineKeyboardButton(f"Купить {offer['id']}", callback_data=f"buy_offer_{offer['id']}"))
    await message.answer(text, reply_markup=kb)

@dp.callback_query_handler(lambda c: c.data.startswith("buy_offer_"))
async def buy_offer_callback(callback: types.CallbackQuery, state: FSMContext):
    offer_id = int(callback.data.split("_")[2])
    user_id = callback.from_user.id
    async with db_pool.acquire() as conn:
        async with conn.transaction():
            offer = await conn.fetchrow("SELECT * FROM authority_offers WHERE id=$1 AND status='active'", offer_id)
            if not offer:
                await callback.answer("❌ Предложение уже неактивно.", show_alert=True)
                return
            if offer['seller_id'] == user_id:
                await callback.answer("❌ Нельзя купить свой же товар.", show_alert=True)
                return
            total_price = offer['amount'] * offer['price_per_unit']
            balance = await get_user_balance(user_id)
            if balance < total_price:
                await callback.answer(f"❌ Недостаточно баксов. Нужно {total_price}.", show_alert=True)
                return
            # Проверяем, что у продавца всё ещё есть авторитет
            seller_auth = await get_user_global_authority(offer['seller_id'])
            if seller_auth < offer['amount']:
                await callback.answer("❌ У продавца больше нет такого количества авторитета. Предложение отменяется.", show_alert=True)
                await conn.execute("UPDATE authority_offers SET status='cancelled' WHERE id=$1", offer_id)
                return
            # Списание денег у покупателя
            await update_user_balance(user_id, -total_price, conn=conn)
            # Начисление денег продавцу
            await update_user_balance(offer['seller_id'], total_price, conn=conn)
            # Передача авторитета покупателю
            await update_user_global_authority(user_id, offer['amount'], conn=conn)
            # Списание авторитета у продавца
            await update_user_global_authority(offer['seller_id'], -offer['amount'], conn=conn)
            # Помечаем оффер как завершённый
            await conn.execute(
                "UPDATE authority_offers SET status='sold', buyer_id=$1, bought_at=$2 WHERE id=$3",
                user_id, datetime.now(), offer_id
            )
    await callback.answer(f"✅ Покупка совершена! Ты получил {offer['amount']} авторитета.", show_alert=True)
    await callback.message.delete()
    await callback.message.answer("Главное меню:", reply_markup=user_main_keyboard(await is_admin(user_id)))

@dp.message_handler(lambda message: message.text == "📋 Мои активные предложения")
async def my_offers(message: types.Message):
    if message.chat.type != 'private':
        return
    user_id = message.from_user.id
    if await is_banned(user_id):
        return
    ok, not_subscribed = await check_subscription(user_id)
    if not ok:
        await message.answer("❗️ Сначала подпишись на каналы.", reply_markup=subscription_inline(not_subscribed))
        return
    async with db_pool.acquire() as conn:
        offers = await conn.fetch(
            "SELECT id, amount, price_per_unit, created_at FROM authority_offers WHERE seller_id=$1 AND status='active'",
            user_id
        )
    if not offers:
        await message.answer("У тебя нет активных предложений.")
        return
    text = "📋 Твои активные предложения:\n\n"
    kb = InlineKeyboardMarkup(row_width=1)
    for offer in offers:
        text += f"🆔 {offer['id']} | {offer['amount']} ед. по {offer['price_per_unit']} баксов/ед (создано: {offer['created_at']})\n"
        kb.add(InlineKeyboardButton(f"❌ Отменить {offer['id']}", callback_data=f"cancel_offer_{offer['id']}"))
    await message.answer(text, reply_markup=kb)

@dp.callback_query_handler(lambda c: c.data.startswith("cancel_offer_"))
async def cancel_offer_callback(callback: types.CallbackQuery):
    offer_id = int(callback.data.split("_")[2])
    user_id = callback.from_user.id
    async with db_pool.acquire() as conn:
        offer = await conn.fetchrow("SELECT * FROM authority_offers WHERE id=$1 AND seller_id=$2 AND status='active'", offer_id, user_id)
        if not offer:
            await callback.answer("❌ Предложение не найдено или уже неактивно.", show_alert=True)
            return
        await conn.execute("UPDATE authority_offers SET status='cancelled' WHERE id=$1", offer_id)
    await callback.answer("✅ Предложение отменено.", show_alert=True)
    await callback.message.delete()

