@dp.message_handler(lambda message: message.text == "📋 Список комнат")
async def list_rooms(message: types.Message):
    if message.chat.type != 'private':
        return
    user_id = message.from_user.id
    if await is_banned(user_id):
        return
    ok, not_subscribed = await check_subscription(user_id)
    if not ok:
        await message.answer("❗️ Сначала подпишись на каналы.", reply_markup=subscription_inline(not_subscribed))
        return
    async with db_pool.acquire() as conn:
        rooms = await conn.fetch(
            "SELECT game_id, host_id, max_players, bet_amount, "
            "(SELECT COUNT(*) FROM game_players WHERE game_id = multiplayer_games.game_id) as players_count "
            "FROM multiplayer_games WHERE status='waiting' ORDER BY created_at"
        )
    if not rooms:
        await message.answer("Нет открытых комнат. Создай свою!")
        return
    text = "📋 Открытые комнаты:\n\n"
    kb = InlineKeyboardMarkup(row_width=1)
    for room in rooms:
        host_name = (await conn.fetchval("SELECT first_name FROM users WHERE user_id=$1", room['host_id'])) or f"ID {room['host_id']}"
        text += f"🆔 {room['game_id']} | Хост: {host_name}\n   👥 {room['players_count']}/{room['max_players']} игроков, ставка: {room['bet_amount']} баксов\n\n"
        kb.add(InlineKeyboardButton(f"Присоединиться к {room['game_id']}", callback_data=f"join_room_{room['game_id']}"))
    await message.answer(text, reply_markup=kb)

@dp.callback_query_handler(lambda c: c.data.startswith("join_room_"))
async def join_room_callback(callback: types.CallbackQuery, state: FSMContext):
    game_id = callback.data.split("_")[2]
    user_id = callback.from_user.id
    async with db_pool.acquire() as conn:
        room = await conn.fetchrow("SELECT * FROM multiplayer_games WHERE game_id=$1 AND status='waiting'", game_id)
        if not room:
            await callback.answer("❌ Комната уже закрыта или началась.", show_alert=True)
            return
        # Проверим, не в игре ли уже пользователь в другой комнате
        existing_game = await conn.fetchval(
            "SELECT 1 FROM multiplayer_games g JOIN game_players p ON g.game_id = p.game_id WHERE p.user_id=$1 AND g.status='playing'",
            user_id
        )
        if existing_game:
            await callback.answer("❌ Ты уже в активной игре. Закончи её.", show_alert=True)
            return
        existing = await conn.fetchval("SELECT 1 FROM game_players WHERE game_id=$1 AND user_id=$2", game_id, user_id)
        if existing:
            await callback.answer("❌ Ты уже в этой комнате.", show_alert=True)
            return
        current_players = await conn.fetchval("SELECT COUNT(*) FROM game_players WHERE game_id=$1", game_id)
        if current_players >= room['max_players']:
            await callback.answer("❌ Комната уже полная.", show_alert=True)
            return
        balance = await get_user_balance(user_id)
        if balance < room['bet_amount']:
            await callback.answer(f"❌ Недостаточно баксов. Нужно {room['bet_amount']}.", show_alert=True)
            return
        await conn.execute(
            "INSERT INTO game_players (game_id, user_id, username, joined_at) VALUES ($1, $2, $3, $4)",
            game_id, user_id, callback.from_user.first_name, datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        )
    await callback.answer("✅ Ты присоединился к комнате!", show_alert=True)
    await callback.message.delete()
    await show_room_status(callback.message, game_id)

async def show_room_status(message: types.Message, game_id: str):
    async with db_pool.acquire() as conn:
        room = await conn.fetchrow("SELECT * FROM multiplayer_games WHERE game_id=$1", game_id)
        if not room:
            await message.answer("❌ Комната не найдена.")
            return
        players = await conn.fetch("SELECT user_id, username FROM game_players WHERE game_id=$1", game_id)
        player_list = "\n".join([f"• {p['username']} (ID: {p['user_id']})" for p in players])
        text = f"🆔 Комната {game_id}\nСтавка: {room['bet_amount']} баксов\nИгроки ({len(players)}/{room['max_players']}):\n{player_list}"
        kb = None
        if room['host_id'] == message.from_user.id:
            kb = room_control_keyboard(game_id)
        else:
            kb = leave_room_keyboard(game_id)
        await message.answer(text, reply_markup=kb)

@dp.message_handler(lambda message: message.text == "🎮 Создать комнату")
async def create_room_start(message: types.Message, state: FSMContext):
    if message.chat.type != 'private':
        return
    user_id = message.from_user.id
    if await is_banned(user_id):
        return
    ok, not_subscribed = await check_subscription(user_id)
    if not ok:
        await message.answer("❗️ Сначала подпишись на каналы.", reply_markup=subscription_inline(not_subscribed))
        return
    # Проверим, не в игре ли уже
    async with db_pool.acquire() as conn:
        existing = await conn.fetchval(
            "SELECT 1 FROM multiplayer_games g JOIN game_players p ON g.game_id = p.game_id WHERE p.user_id=$1 AND g.status IN ('waiting','playing')",
            user_id
        )
        if existing:
            await message.answer("❌ Ты уже находишься в комнате или игре. Выйди сначала.")
            return
    await message.answer("Введи максимальное количество игроков (2-5):", reply_markup=back_keyboard())
    await MultiplayerGame.create_max_players.set()

@dp.message_handler(state=MultiplayerGame.create_max_players)
async def create_room_max_players(message: types.Message, state: FSMContext):
    if message.text == "◀️ Назад":
        await state.finish()
        await multiplayer_main_menu(message)
        return
    try:
        max_players = int(message.text)
        if max_players < 2 or max_players > 5:
            raise ValueError
    except ValueError:
        await message.answer("❌ Введи число от 2 до 5.")
        return
    await state.update_data(max_players=max_players)
    await message.answer("Введи ставку (целое положительное число):")
    await MultiplayerGame.create_bet.set()

@dp.message_handler(state=MultiplayerGame.create_bet)
async def create_room_bet(message: types.Message, state: FSMContext):
    if message.text == "◀️ Назад":
        await state.finish()
        await multiplayer_main_menu(message)
        return
    try:
        bet = int(message.text)
        if bet <= 0:
            raise ValueError
    except ValueError:
        await message.answer("❌ Введи положительное целое число.")
        return
    user_id = message.from_user.id
    balance = await get_user_balance(user_id)
    if balance < bet:
        await message.answer("❌ Недостаточно баксов.")
        await state.finish()
        return
    data = await state.get_data()
    max_players = data['max_players']
    game_id = generate_game_id()
    async with db_pool.acquire() as conn:
        await conn.execute(
            "INSERT INTO multiplayer_games (game_id, host_id, max_players, bet_amount, created_at, status) VALUES ($1, $2, $3, $4, $5, 'waiting')",
            game_id, user_id, max_players, bet, datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        )
        await conn.execute(
            "INSERT INTO game_players (game_id, user_id, username, joined_at) VALUES ($1, $2, $3, $4)",
            game_id, user_id, message.from_user.first_name, datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        )
    await message.answer(f"✅ Комната создана! Код: {game_id}")
    await show_room_status(message, game_id)
    await state.finish()

@dp.callback_query_handler(lambda c: c.data.startswith("leave_room_"))
async def leave_room_callback(callback: types.CallbackQuery):
    game_id = callback.data.split("_")[2]
    user_id = callback.from_user.id
    async with db_pool.acquire() as conn:
        room = await conn.fetchrow("SELECT * FROM multiplayer_games WHERE game_id=$1 AND status='waiting'", game_id)
        if not room:
            await callback.answer("❌ Комната уже не в ожидании.", show_alert=True)
            return
        # Проверим, что пользователь в комнате
        player = await conn.fetchrow("SELECT * FROM game_players WHERE game_id=$1 AND user_id=$2", game_id, user_id)
        if not player:
            await callback.answer("❌ Тебя нет в этой комнате.", show_alert=True)
            return
        if room['host_id'] == user_id:
            # Хост выходит - удаляем комнату и всех игроков
            await conn.execute("DELETE FROM game_players WHERE game_id=$1", game_id)
            await conn.execute("DELETE FROM multiplayer_games WHERE game_id=$1", game_id)
            await callback.answer("✅ Комната закрыта (вы были хостом).", show_alert=True)
        else:
            await conn.execute("DELETE FROM game_players WHERE game_id=$1 AND user_id=$2", game_id, user_id)
            await callback.answer("✅ Ты покинул комнату.", show_alert=True)
    await callback.message.delete()

@dp.callback_query_handler(lambda c: c.data.startswith("start_game_"))
async def start_game_callback(callback: types.CallbackQuery):
    game_id = callback.data.split("_")[2]
    user_id = callback.from_user.id
    async with db_pool.acquire() as conn:
        room = await conn.fetchrow("SELECT * FROM multiplayer_games WHERE game_id=$1 AND status='waiting'", game_id)
        if not room:
            await callback.answer("❌ Комната уже началась или закрыта.", show_alert=True)
            return
        if room['host_id'] != user_id:
            await callback.answer("❌ Только хост может начать игру.", show_alert=True)
            return
        players = await conn.fetch("SELECT user_id FROM game_players WHERE game_id=$1", game_id)
        if len(players) < 2:
            await callback.answer("❌ Недостаточно игроков (минимум 2).", show_alert=True)
            return
        # Проверим баланс всех игроков
        for p in players:
            bal = await get_user_balance(p['user_id'])
            if bal < room['bet_amount']:
                name = await conn.fetchval("SELECT username FROM game_players WHERE game_id=$1 AND user_id=$2", game_id, p['user_id'])
                await callback.answer(f"❌ У игрока {name} недостаточно баксов.", show_alert=True)
                return
        # Списываем ставки
        for p in players:
            await update_user_balance(p['user_id'], -room['bet_amount'], conn=conn)
        # Создаём колоду
        deck = create_deck()
        deck_str = ','.join(deck)
        await conn.execute(
            "UPDATE multiplayer_games SET status='playing', deck=$1, current_player_index=0 WHERE game_id=$2",
            deck_str, game_id
        )
        # Раздаём по 2 карты каждому
        for p in players:
            cards = [deck.pop(), deck.pop()]
            value = calculate_hand_value(cards)
            await conn.execute(
                "UPDATE game_players SET cards=$1, value=$2 WHERE game_id=$3 AND user_id=$4",
                ','.join(cards), value, game_id, p['user_id']
            )
        # Обновляем колоду в игре
        await conn.execute("UPDATE multiplayer_games SET deck=$1 WHERE game_id=$2", ','.join(deck), game_id)
    await callback.answer()
    await callback.message.delete()
    await process_game_turn(game_id)

async def process_game_turn(game_id: str):
    async with db_pool.acquire() as conn:
        game = await conn.fetchrow("SELECT * FROM multiplayer_games WHERE game_id=$1", game_id)
        if not game or game['status'] != 'playing':
            return
        players = await conn.fetch(
            "SELECT * FROM game_players WHERE game_id=$1 ORDER BY user_id", game_id
        )
        current_index = game['current_player_index']
        if current_index >= len(players):
            # Все сыграли, подводим итоги
            await finish_game(game_id)
            return
        current_player = players[current_index]
        if current_player['stopped'] or current_player['surrendered'] or current_player['value'] > 21:
            # Игрок уже закончил или перебор, переходим к следующему
            await conn.execute(
                "UPDATE multiplayer_games SET current_player_index = current_player_index + 1 WHERE game_id=$1",
                game_id
            )
            await process_game_turn(game_id)
            return
        # Отправляем сообщение игроку
        user_id = current_player['user_id']
        cards = current_player['cards'].split(',') if current_player['cards'] else []
        value = current_player['value']
        hand_str = ' '.join(cards)
        status_str = f"🎯 {value} очков" if value <= 21 else "💥 Перебор"
        can_double = len(cards) == 2 and not current_player['doubled']
        text = (
            f"🎮 Твой ход в игре {game_id}!\n"
            f"Твои карты: {hand_str}\n"
            f"{status_str}\n\n"
            f"Выбери действие:"
        )
        kb = room_action_keyboard(game_id, can_double)
        await safe_send_message(user_id, text, reply_markup=kb)

@dp.callback_query_handler(lambda c: c.data.startswith("room_"))
async def room_action_callback(callback: types.CallbackQuery, state: FSMContext):
    action = callback.data.split("_")[1]
    user_id = callback.from_user.id
    async with db_pool.acquire() as conn:
        game = await conn.fetchrow(
            "SELECT g.* FROM multiplayer_games g JOIN game_players p ON g.game_id = p.game_id "
            "WHERE p.user_id=$1 AND g.status='playing'",
            user_id
        )
        if not game:
            await callback.answer("❌ Ты не в активной игре.", show_alert=True)
            return
        player = await conn.fetchrow("SELECT * FROM game_players WHERE game_id=$1 AND user_id=$2", game['game_id'], user_id)
        if not player:
            await callback.answer("❌ Ошибка: игрок не найден.", show_alert=True)
            return
        # Проверим, что сейчас его ход
        players = await conn.fetch("SELECT user_id FROM game_players WHERE game_id=$1 ORDER BY user_id", game['game_id'])
        current_index = game['current_player_index']
        if current_index >= len(players) or players[current_index]['user_id'] != user_id:
            await callback.answer("❌ Сейчас не твой ход.", show_alert=True)
            return
        deck = game['deck'].split(',') if game['deck'] else []
        cards = player['cards'].split(',') if player['cards'] else []
        value = player['value']
        if action == "hit":
            if not deck:
                await callback.answer("❌ Колода пуста!", show_alert=True)
                return
            new_card = deck.pop()
            cards.append(new_card)
            new_value = calculate_hand_value(cards)
            await conn.execute(
                "UPDATE game_players SET cards=$1, value=$2 WHERE game_id=$3 AND user_id=$4",
                ','.join(cards), new_value, game['game_id'], user_id
            )
            await conn.execute(
                "UPDATE multiplayer_games SET deck=$1 WHERE game_id=$2",
                ','.join(deck), game['game_id']
            )
            if new_value > 21:
                # Перебор, ход заканчивается
                await conn.execute(
                    "UPDATE game_players SET stopped=TRUE WHERE game_id=$1 AND user_id=$2",
                    game['game_id'], user_id
                )
                await callback.answer("💥 Перебор!", show_alert=True)
                # Переходим к следующему
                await conn.execute(
                    "UPDATE multiplayer_games SET current_player_index = current_player_index + 1 WHERE game_id=$1",
                    game['game_id']
                )
                await callback.message.delete()
                await process_game_turn(game['game_id'])
            else:
                # Продолжаем ход
                await callback.answer()
                await callback.message.edit_text(
                    f"Твои карты: {' '.join(cards)}\n🎯 {new_value} очков\n\nВыбери действие:",
                    reply_markup=room_action_keyboard(game['game_id'], can_double=(len(cards)==2 and not player['doubled']))
                )
        elif action == "stand":
            await conn.execute(
                "UPDATE game_players SET stopped=TRUE WHERE game_id=$1 AND user_id=$2",
                game['game_id'], user_id
            )
            await conn.execute(
                "UPDATE multiplayer_games SET current_player_index = current_player_index + 1 WHERE game_id=$1",
                game['game_id']
            )
            await callback.answer("✅ Ты остановился.", show_alert=True)
            await callback.message.delete()
            await process_game_turn(game['game_id'])
        elif action == "double":
            if len(cards) != 2 or player['doubled']:
                await callback.answer("❌ Удвоить можно только на первых двух картах и только один раз.", show_alert=True)
                return
            balance = await get_user_balance(user_id)
            if balance < game['bet_amount']:
                await callback.answer("❌ Недостаточно баксов для удвоения.", show_alert=True)
                return
            # Списываем ещё одну ставку
            await update_user_balance(user_id, -game['bet_amount'], conn=conn)
            # Добавляем одну карту
            if not deck:
                await callback.answer("❌ Колода пуста!", show_alert=True)
                return
            new_card = deck.pop()
            cards.append(new_card)
            new_value = calculate_hand_value(cards)
            await conn.execute(
                "UPDATE game_players SET cards=$1, value=$2, doubled=TRUE WHERE game_id=$3 AND user_id=$4",
                ','.join(cards), new_value, game['game_id'], user_id
            )
            await conn.execute(
                "UPDATE multiplayer_games SET deck=$1 WHERE game_id=$2",
                ','.join(deck), game['game_id']
            )
            # Ход заканчивается
            await conn.execute(
                "UPDATE multiplayer_games SET current_player_index = current_player_index + 1 WHERE game_id=$1",
                game['game_id']
            )
            await callback.answer(f"✅ Удвоено! Ты получил карту {new_card}.", show_alert=True)
            await callback.message.delete()
            await process_game_turn(game['game_id'])
        elif action == "surrender":
            # Исправленный расчёт возврата с учётом удвоения
            total_bet = game['bet_amount'] * (2 if player['doubled'] else 1)
            refund = total_bet // 2
            await conn.execute(
                "UPDATE game_players SET surrendered=TRUE WHERE game_id=$1 AND user_id=$2",
                game['game_id'], user_id
            )
            await conn.execute(
                "UPDATE multiplayer_games SET current_player_index = current_player_index + 1 WHERE game_id=$1",
                game['game_id']
            )
            await update_user_balance(user_id, refund, conn=conn)
            await callback.answer(f"🏳️ Ты сдался и теряешь половину ставки. Возвращено {refund} баксов.", show_alert=True)
            await callback.message.delete()
            await process_game_turn(game['game_id'])
        elif action == "chat":
            await callback.message.answer("Введи сообщение для всех в комнате:")
            await RoomChat.message.set()
            await state.update_data(game_id=game['game_id'])

@dp.message_handler(state=RoomChat.message)
async def room_chat_message(message: types.Message, state: FSMContext):
    data = await state.get_data()
    game_id = data['game_id']
    text = message.text
    async with db_pool.acquire() as conn:
        players = await conn.fetch("SELECT user_id FROM game_players WHERE game_id=$1", game_id)
        for p in players:
            if p['user_id'] != message.from_user.id:
                await safe_send_message(p['user_id'], f"💬 Сообщение из комнаты {game_id} от {message.from_user.first_name}: {text}")
    await message.answer("✅ Сообщение отправлено всем в комнате.")
    await state.finish()

async def finish_game(game_id: str):
    async with db_pool.acquire() as conn:
        game = await conn.fetchrow("SELECT * FROM multiplayer_games WHERE game_id=$1", game_id)
        if not game or game['status'] != 'playing':
            return
        players = await conn.fetch("SELECT * FROM game_players WHERE game_id=$1", game_id)
        # Определяем победителя: ближайший к 21 без перебора
        best_value = 0
        winner_id = None
        for p in players:
            if p['surrendered']:
                continue
            val = p['value']
            if val <= 21 and val > best_value:
                best_value = val
                winner_id = p['user_id']
        if best_value == 0:
            # Все перебрали или сдались – возвращаем ставки всем, кроме сдавшихся
            for p in players:
                if not p['surrendered']:
                    await update_user_balance(p['user_id'], game['bet_amount'], conn=conn)
            result_text = "🤷 Никто не выиграл. Ставки возвращены."
        else:
            # Есть победитель (или несколько с одинаковым счётом)
            winners = [p for p in players if p['value'] == best_value and not p['surrendered']]
            total_pot = game['bet_amount'] * len([p for p in players if not p['surrendered']])
            share = total_pot // len(winners)
            remainder = total_pot % len(winners)
            for i, w in enumerate(winners):
                win_amount = share + (1 if i < remainder else 0)
                await update_user_balance(w['user_id'], win_amount, conn=conn)
                await update_user_game_stats(w['user_id'], 'multiplayer', win=True, conn=conn)
                exp = int(await get_setting("exp_per_game_win"))
                await add_exp(w['user_id'], exp, conn=conn)
                await update_user_global_authority(w['user_id'], 5, conn=conn)  # за победу в мультиплеере
            if len(winners) == 1:
                result_text = f"🏆 Победитель: {winners[0]['username']} с {best_value} очками! Выигрыш: {share} баксов."
            else:
                result_text = f"🎉 Ничья! Победители с {best_value} очками делят банк."
        # Отправляем результат всем игрокам
        for p in players:
            await safe_send_message(p['user_id'], f"Игра {game_id} завершена!\n{result_text}")
            if p['user_id'] not in [w['user_id'] for w in winners] and not p['surrendered']:
                # Проигравшим начисляем опыт за поражение
                exp = int(await get_setting("exp_per_game_lose"))
                await add_exp(p['user_id'], exp, conn=conn)
        await conn.execute("UPDATE multiplayer_games SET status='finished' WHERE game_id=$1", game_id)

@dp.callback_query_handler(lambda c: c.data.startswith("close_room_"))
async def close_room_callback(callback: types.CallbackQuery):
    game_id = callback.data.split("_")[2]
    user_id = callback.from_user.id
    async with db_pool.acquire() as conn:
        room = await conn.fetchrow("SELECT * FROM multiplayer_games WHERE game_id=$1", game_id)
        if not room:
            await callback.answer("❌ Комната не найдена.", show_alert=True)
            return
        if room['host_id'] != user_id:
            await callback.answer("❌ Только хост может закрыть комнату.", show_alert=True)
            return
        if room['status'] != 'waiting':
            await callback.answer("❌ Игра уже началась, нельзя закрыть.", show_alert=True)
            return
        players = await conn.fetch("SELECT user_id FROM game_players WHERE game_id=$1", game_id)
        for p in players:
            if p['user_id'] != user_id:
                await safe_send_message(p['user_id'], f"❌ Комната {game_id} закрыта хостом.")
        await conn.execute("DELETE FROM game_players WHERE game_id=$1", game_id)
        await conn.execute("DELETE FROM multiplayer_games WHERE game_id=$1", game_id)
    await callback.answer("✅ Комната закрыта.", show_alert=True)
    await callback.message.delete()

@dp.message_handler(lambda message: message.text == "🏆 Топ мультиплеера")
async def multiplayer_top(message: types.Message):
    if message.chat.type != 'private':
        return
    user_id = message.from_user.id
    if await is_banned(user_id):
        return
    ok, not_subscribed = await check_subscription(user_id)
    if not ok:
        await message.answer("❗️ Сначала подпишись на каналы.", reply_markup=subscription_inline(not_subscribed))
        return
    async with db_pool.acquire() as conn:
        rows = await conn.fetch("SELECT first_name, multiplayer_wins FROM users ORDER BY multiplayer_wins DESC LIMIT 10")
    if not rows:
        await message.answer("Нет данных.")
        return
    text = "🏆 Топ мультиплеера (по победам):\n\n"
    for i, row in enumerate(rows, 1):
        text += f"{i}. {row['first_name']} – {row['multiplayer_wins']} побед\n"
    await message.answer(text, reply_markup=games_menu_keyboard())

