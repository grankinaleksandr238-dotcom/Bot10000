        await message.answer(phrase, reply_markup=user_main_keyboard(await is_admin(user_id)))
    else:
        loss = amount
        await update_user_balance(user_id, -loss)
        await update_user_game_stats(user_id, 'slots', win=False)
        exp = int(await get_setting("exp_per_slots_lose"))
        await add_exp(user_id, exp)
        phrase = get_random_phrase(SLOTS_LOSE_PHRASES, combo=combo, loss=loss)
        await message.answer(phrase, reply_markup=user_main_keyboard(await is_admin(user_id)))
    await state.finish()

