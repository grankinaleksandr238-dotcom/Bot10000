@dp.message_handler(state=CasinoBet.amount)
async def casino_bet_amount(message: types.Message, state: FSMContext):
    if message.text == "◀️ Назад":
        await state.finish()
        await casino_menu(message)
        return
    try:
        amount = int(message.text)
        if amount <= 0:
            raise ValueError
    except ValueError:
        await message.answer("❌ Введи положительное целое число.")
        return
    user_id = message.from_user.id
    balance = await get_user_balance(user_id)
    if balance < amount:
        await message.answer("❌ Недостаточно баксов.")
        await state.finish()
        return
    # Проверка на мин/макс ставку
    min_bet = int(await get_setting("casino_min_bet"))
    max_bet = int(await get_setting("casino_max_bet"))
    if amount < min_bet or amount > max_bet:
        await message.answer(f"❌ Ставка должна быть от {min_bet} до {max_bet} баксов.")
        await state.finish()
        return
    win_chance = int(await get_setting("casino_win_chance"))
    if random.randint(1, 100) <= win_chance:
        multiplier = int(await get_setting("casino_multiplier"))
        win = amount * multiplier
        await update_user_balance(user_id, win)
        await update_user_game_stats(user_id, 'casino', win=True)
        exp = int(await get_setting("exp_per_casino_win"))
        await add_exp(user_id, exp)
        await update_user_global_authority(user_id, 2)
        phrase = get_random_phrase(CASINO_WIN_PHRASES, win=win, profit=win)
        await message.answer(phrase, reply_markup=user_main_keyboard(await is_admin(user_id)))
    else:
        loss = amount
        await update_user_balance(user_id, -loss)
        await update_user_game_stats(user_id, 'casino', win=False)
        exp = int(await get_setting("exp_per_casino_lose"))
        await add_exp(user_id, exp)
        phrase = get_random_phrase(CASINO_LOSE_PHRASES, loss=loss)
        await message.answer(phrase, reply_markup=user_main_keyboard(await is_admin(user_id)))
    await state.finish()

