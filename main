    await message.answer("Введи число от 1 до 5:")
    await GuessBet.number.set()

@dp.message_handler(state=GuessBet.number)
async def guess_bet_number(message: types.Message, state: FSMContext):
    if message.text == "◀️ Назад":
        await state.finish()
        await casino_menu(message)
        return
    try:
        number = int(message.text)
        if number < 1 or number > 5:
            raise ValueError
    except ValueError:
        await message.answer("❌ Введи целое число от 1 до 5.")
        return
    data = await state.get_data()
    amount = data['amount']
    user_id = message.from_user.id
    secret = random.randint(1, 5)
    multiplier = int(await get_setting("guess_multiplier"))
    rep_reward = int(await get_setting("guess_reputation"))
    if number == secret:
        win = amount * multiplier
        await update_user_balance(user_id, win)
        await update_user_reputation(user_id, rep_reward)
        await update_user_game_stats(user_id, 'guess', win=True)
        exp = int(await get_setting("exp_per_guess_win"))
        await add_exp(user_id, exp)
        await update_user_global_authority(user_id, 2)
        phrase = get_random_phrase(GUESS_WIN_PHRASES, secret=secret, profit=win, rep=rep_reward)
        await message.answer(phrase, reply_markup=user_main_keyboard(await is_admin(user_id)))
    else:
        loss = amount
        await update_user_balance(user_id, -loss)
        await update_user_game_stats(user_id, 'guess', win=False)
        exp = int(await get_setting("exp_per_guess_lose"))
        await add_exp(user_id, exp)
        phrase = get_random_phrase(GUESS_LOSE_PHRASES, secret=secret, loss=loss)
        await message.answer(phrase, reply_markup=user_main_keyboard(await is_admin(user_id)))
    await state.finish()

